{
  "name": "stockfish-chess-studio",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build && tsx scripts/write-build-identity.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "tsx scripts/run_gates.ts",
    "levels": "tsx scripts/test-level-scan.ts",
    "read:vocabulary": "tsx scripts/read_vocabulary.ts",
    "db:generate": "drizzle-kit generate",
    "gates:controls": "tsx scripts/run_gates.ts --positive-controls",
    "verify": "npm run check && npm run build && npm test && npm run gates && npm run gates:controls && npm run bundle:budget",
    "bundle:budget": "tsx scripts/check_bundle_budget.ts",
    "check:control": "tsc --noEmit -p tests/fixtures/typecheck/tsconfig.json",
    "bundle:budget:control": "BUNDLE_ROOT=tests/fixtures/bundle tsx scripts/check_bundle_budget.ts",
    "falsification": "tsx scripts/falsification-report.ts",
    "purge": "tsx scripts/purge.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.10.1",
    "stockfish": "^18.0.8",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.7",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
