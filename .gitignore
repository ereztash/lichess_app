node_modules/
dist/
*.local
.env
.env.*
!.env.example
.vercel
.DS_Store
*.tsbuildinfo

# emitted by tests/server/serverless-entry.test.ts
.entry-check/

# Research engine output: hundreds of megabytes of search results, rebuildable from the manifests
# beside them (seed, engine, options, budgets, sha256). The manifests and summaries ARE committed --
# they are the provenance record and are what the results document quotes.
research/blitz/data/*.jsonl
__pycache__/

# Research harness output: real PGNs and per-decision engine evidence, rebuildable from the
# manifests beside them.
research/harness/corpus.json
research/harness/*.jsonl
research/harness/*.zst
research/harness-shipped/corpus.json
research/harness-shipped/*.jsonl
research/b2/corpus.json
research/b2/*.jsonl

# Oracle run progress, written to stderr. The results beside it are the record.
research/discovery-oracle/results/*.log

# B3 population study: scored per-decision evidence, hundreds of megabytes, rebuildable from the
# manifests beside it (source URL, prefix bytes, prefix sha256, seed, acceptance rates, caps,
# engine identity and options). The manifests and the analysis outputs ARE committed -- they are
# the provenance record and are what the report quotes.
research/b3_population_expertise/data/**/*.jsonl.zst
research/b3_population_expertise/b2_repro/*.jsonl
research/b3_population_expertise/b2_repro/corpus.json
.venv-b3/
